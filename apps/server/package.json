{
  "name": "@bang/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "db:check": "node --env-file-if-exists=../../.env --import tsx src/check-database.ts"
  },
  "dependencies": {
    "@bang/contracts": "*",
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "socket.io": "4.8.4"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "socket.io-client": "4.8.4",
    "tsx": "4.23.15"
  }
}
