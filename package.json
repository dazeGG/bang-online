{
  "name": "bang-online",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private, cross-platform classic BANG! for 4–7 friends.",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "predev": "npm run build:packages",
    "dev": "concurrently --kill-others -n packages,web,server \"npm:dev:packages\" \"npm:dev:web\" \"npm:dev:server\"",
    "dev:packages": "tsc -b packages/game-core packages/contracts --watch --preserveWatchOutput",
    "dev:web": "npm run dev --workspace @bang/web",
    "dev:server": "npm run dev --workspace @bang/server",
    "build:packages": "tsc -b packages/game-core packages/contracts",
    "build": "npm run build:packages && npm run build --workspace @bang/server && npm run build --workspace @bang/web",
    "typecheck": "npm run build:packages && npm run typecheck --workspaces --if-present && tsc -p tsconfig.tests.json --noEmit",
    "lint": "eslint .",
    "pretest": "npm run build:packages",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run format:check",
    "start": "npm run start --workspace @bang/server",
    "preview": "npm run preview --workspace @bang/web",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:check": "npm run db:check --workspace @bang/server"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "concurrently": "10.0.7",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0"
  }
}
